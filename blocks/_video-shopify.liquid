
<div class="video-slide video-slide--{{ block.id }}" data-index="{{ block.settings.slide_index }}" {{ block.shopify_attributes }}>
 
 <div class="video-wrapper" style='aspect-ratio: 0.56;'>
    {% if block.settings.video != blank %}
    {{ block.settings.video | video_tag: image_size: "1024x", controls: true, autoplay: false, loop: false, muted: false }}
    {% endif %}
  </div>

        <div class="product-small-link">
            <div class="product-img"></div>
            <div class="product-title"></div>
        </div>
</div>


{% schema %}
    {
      "name": "Video shopify",
      "tag": null,
      "settings": [
        {
        "type": "number",
        "id": "slide_index",
        "label": "Slide Index",
        "default": 0
        },
        {
            "type": "video",
            "id": "video",
            "label": "A Shopify-hosted video"
            },
        {
            "type": "product",
            "id": "product",
            "label": "Product"
        }
      ],
      "presets": [
        {
          "name": "Video shopify"
        }
      ]
    }
{% endschema %}