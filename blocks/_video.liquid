
<div class="video-slide video-slide--{{ block.id }}" data-index="{{ block.settings.slide_index }}" {{ block.shopify_attributes }}>
 
 <div class="video-wrapper" style='aspect-ratio: 0.8;'>
  
    {% if block.settings.video_url == blank %}
       <div class="iframe-overlay-wrapper">
            <iframe src="//www.youtube.com/embed/_9VUPq3SxOc?rel=0&showinfo=0&vq=720" width="850" height="480" frameborder="0" allowfullscreen></iframe>
        </div>
            {% else %}
        {% if block.settings.video_url.type == 'youtube' %}
           <div class="iframe-overlay-wrapper">
        <iframe src="//www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0&showinfo=0&vq=720" width="850" height="480" frameborder="0" allowfullscreen></iframe>
      </div>  
      {% endif %}
        {% if block.settings.video_url.type == 'vimeo' %}
            <div class="iframe-overlay-wrapper">
        <iframe src="//player.vimeo.com/video/{{ block.settings.video_url.id }}?color={{ block.color_button | remove: "#" }}&byline=0&portrait=0&badge=0" width="850" height="480" frameborder="0" allowfullscreen></iframe>
      </div>  
      {% endif %}
    {% endif %}
  </div>

  {% if block.settings.product != blank %}
        <a href='{{ block.settings.product.url }}' class="product-small-link">
            <div class="product-img">
               <div class="image-wrap aos-animate article__featured-image" style="aspect-ratio: 1;">
              {%- render 'image-element',
                img: block.settings.product.featured_image,
                widths: '360, 540, 750, 900, 1080, 1600',
                sizeVariable: '200px',
              -%}
            </div>

            </div>
            <div class="product-title">{{ block.settings.product.title | truncate: 16 }}</div>
            <div class="small-product-bag-icon">
               <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-bag-minimal"  viewBox="0 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.9999 7.0498H3.57688C3.27193 7.04984 2.97103 7.11962 2.69718 7.25379C2.42333 7.38797 2.18379 7.58299 1.99688 7.82394C1.80996 8.06489 1.68062 8.3454 1.61875 8.64401C1.55687 8.94262 1.5641 9.25142 1.63988 9.5468L3.69088 17.5468C3.80127 17.9771 4.05177 18.3584 4.40287 18.6305C4.75396 18.9027 5.18567 19.0502 5.62988 19.0498H16.3699C16.8138 19.0497 17.245 18.902 17.5957 18.6299C17.9464 18.3578 18.1966 17.9768 18.3069 17.5468L20.3589 9.5468C20.4347 9.25142 20.4419 8.94262 20.38 8.64401C20.3181 8.3454 20.1888 8.06489 20.0019 7.82394C19.815 7.58299 19.5754 7.38797 19.3016 7.25379C19.0277 7.11962 18.7268 7.04984 18.4219 7.0498H10.9999ZM10.9999 7.0498V1.0498" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
            </div>
             </a>
  {% endif %}
</div>


{% schema %}
    {
      "name": "Video youtube/vimeo",
      "tag": null,
      "settings": [
        {
        "type": "number",
        "id": "slide_index",
        "label": "Slide Index",
        "default": 0
        },
      
        {
            "type": "video_url",
            "id": "video_url",
            "label": "t:sections.featured-video.settings.video_url.label",
            "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
            "accept": [
                "youtube",
                "vimeo"
            ]
            },
        {
            "type": "product",
            "id": "product",
            "label": "Product"
        }
      ],
      "presets": [
        {
          "name": "Video youtube/vimeo"
        }
      ]
    }
{% endschema %}