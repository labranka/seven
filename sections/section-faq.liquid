<link
  rel="stylesheet"
  href="{{ 'section-faq.css' | asset_url }}"
  media="print"
  onload="this.media='all'">
<noscript>{{ 'section-faq.css' | asset_url | stylesheet_tag }}</noscript>

{% capture blocks_dropdown %}
    {% content_for 'blocks' %}
{% endcapture %}


<faq-section class="faq__wrapper  faq-section-{{ section.id }} aos-init aos-animate"
data-section-id="{{ section.id }}"  
data-aos="fade-up"
  data-aos-duration="800">
  <div class="faq__main-wrapper ">
    <div class="faq__content--wrapper left-side">
        {% if section.settings.title != blank %}
             <div class="faq__title big-heading">
                {{ section.settings.title }}
            </div>
        {% endif %}  
        <div class="faq__dropdown--wrapper right-side not_desktop">
             {{ blocks_dropdown }}
            </div>
         {% if section.settings.text != blank %}
             <div class="faq__txt not_mobile">
                {{ section.settings.text }}
            </div>
        {% endif %}
          {% if section.settings.image != blank %}
            <div class="image-wrap aos-animate faq__icon" style="aspect-ratio:{{ section.settings.image.aspect_ratio }};">
                {%- render 'image-element',
                    img: section.settings.image,
                    widths: '360, 540, 750, 900, 1080, 1600',
                    sizeVariable: '300px',
                -%}
                </div>
        {% endif %}    
            {% if section.settings.text_2 != blank %}
             <div class="faq__txt ">
                {{ section.settings.text_2 }}
            </div>
        {% endif %}
   
    </div>
     <div class="faq__dropdown--wrapper right-side not_mobile">
      {{ blocks_dropdown }}
    </div>
  </div>
</faq-section>

{% schema %}
  {
    "name": "FAQ",
    "settings": [
        {
            "type": "richtext",
            "id": "title",
            "label": "Title",
            "default": "<p>IMAŠ PITANJE? TU SMO DA ODGOVORIMO</p>"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Proveri koja su najčešća pitanja koja su nam korisnici postavljali i pronadji odgovor!</p>"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Icon"
           
        },
        {
            "type": "richtext",
            "id": "text_2",
            "label": "text",
            "default": "<p>Naša podrška je dostupna od Ponedeljka do Petka od : 08:00-16:00. Odgovaramo u roku od 24h</p>"
        }
     
     
    ],
    "blocks": [
     {
        "type": "faq-dropdown"
      }
    ],
    "presets": [
    {
      "name": "FAQ",
      "blocks": [

      
      ]
    }
  ]
  }
{% endschema %}